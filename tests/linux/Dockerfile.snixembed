# Builds snixembed (StatusNotifier -> XEmbed bridge): a real third-party SNI host for protocol tests.
FROM ubuntu:24.04 AS build
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates make gcc valac pkg-config \
        libgtk-3-dev libdbusmenu-gtk3-dev libgee-0.8-dev libglib2.0-dev gettext
RUN git clone --depth 1 https://git.sr.ht/~steef/snixembed /snixembed && cd /snixembed && make && ls -la snixembed
