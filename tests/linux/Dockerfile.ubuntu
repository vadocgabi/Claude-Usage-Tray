# Test environment: a Linux desktop session in a container (X server, session bus, tray host, notifications).
FROM cut-snixembed-build AS snixembed
FROM ubuntu:24.04
COPY --from=snixembed /snixembed/snixembed /usr/local/bin/snixembed
ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-venv python3-tk python3-pil python3-xlib python3-gi \
        xvfb xauth dbus dbus-x11 x11-utils x11-xserver-utils xdotool imagemagick \
        stalonetray dunst libgtk-3-0 libdbusmenu-gtk3-4 libgee-0.8-2 libnotify-bin libglib2.0-bin gnome-keyring libsecret-1-0 dbus-user-session \
        fonts-noto-core fonts-dejavu-core ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
RUN pip3 install --break-system-packages --no-cache-dir jeepney pystray keyring "curl_cffi" python-xlib 2>&1 | tail -2
WORKDIR /src
